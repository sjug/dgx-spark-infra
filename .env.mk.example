# Local convenience overrides for private infrastructure.
# Copy to .env.mk and adjust as needed.

INVENTORY := inventory/hosts.yml
SOURCE_HOST := source-node
DIFF_HOST_A := source-node
DIFF_HOST_B := target-node
CLEANUP_TARGET := cleanup_targets
PACKAGE_TARGET := package_targets
MAINTENANCE_TARGET := cleanup_targets
MANAGED_USER := admin
ANSIBLE_REMOTE_TEMP := /tmp
# Set this to /dev/null for hermetic SSH checks that ignore ~/.ssh/config.
DGX_SSH_CONFIG :=
